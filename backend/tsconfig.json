{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "rootDir": ".",
    "outDir": "./dist",

    "types": ["node"]
  },

  "include": [
    "src/**/*",
    "drizzle.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}